# Copy this file to .env before starting Docker Compose.
# Never commit the resulting .env file.

# Host port publishing
# Keep 127.0.0.1 when using a local reverse proxy.
BIND_ADDRESS=127.0.0.1
API_PORT=8000
UI_PORT=8501

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL_NAME=llama3.1:8b
EMBEDDING_MODEL_NAME=bge-m3

# Vector store
CHROMA_PERSIST_DIR=/app/data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# Ingestion
CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBEDDING_BATCH_SIZE=32

# RAG
RETRIEVAL_TOP_K=5
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# FastAPI
API_HOST=0.0.0.0
API_KEY=REPLACE_WITH_THE_SAME_STRONG_RANDOM_SECRET
API_MAX_UPLOAD_SIZE_MB=25
API_CORS_ORIGINS=["http://localhost:8501"]

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# Logging
LOG_LEVEL=WARNING
LOG_FORMAT=json

# Streamlit
RAG_API_URL=http://api:8000
RAG_API_KEY=REPLACE_WITH_THE_SAME_STRONG_RANDOM_SECRET
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
RAG_CONNECT_TIMEOUT_SECONDS=5
RAG_REQUEST_TIMEOUT_SECONDS=120
RAG_MAX_UPLOAD_SIZE_MB=25
