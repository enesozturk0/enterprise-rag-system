# LLM
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=llama3.1:8b
EMBEDDING_MODEL_NAME=bge-m3

# Vektör DB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Embedding
EMBEDDING_BATCH_SIZE=32

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-in-production
API_MAX_UPLOAD_SIZE_MB=25
API_CORS_ORIGINS=["http://localhost:8501"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Streamlit UI
RAG_API_URL=http://localhost:8000
RAG_API_KEY=change-me-in-production
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
RAG_CONNECT_TIMEOUT_SECONDS=5
RAG_REQUEST_TIMEOUT_SECONDS=120
RAG_MAX_UPLOAD_SIZE_MB=25
